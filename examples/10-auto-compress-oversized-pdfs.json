      "id": "e87a1fa3-963c-436c-844f-ac5605835aa6",
      "name": "Compress PDF",
      "type": "@pdfrest/n8n-nodes-pdfrest.pdfRest",
      "typeVersion": 1,
      "position": [
        2640,
        -160
      ]
    },
    {
      "parameters": {
        "jsCode": "// Measures the compressed file and computes the savings. Carries the original measurements forward.\nfunction toBytes(sizeText) {\n  const m = String(sizeText ?? '').match(/([\\d.]+)\\s*(B|kB|KB|MB|GB)/i);\n  if (!m) return 0;\n  const n = parseFloat(m[1]);\n  const unit = m[2].toLowerCase();\n  return unit === 'gb' ? n * 1e9 : unit === 'mb' ? n * 1e6 : unit === 'kb' ? n * 1e3 : n;\n}\nconst before = $('Measure and Choose Level').first().json;\nconst out = [];\nfor (const item of $input.all()) {\n  const bytes = toBytes(item.binary?.data?.fileSize);\n  const saved = before.originalBytes > 0 ? Math.round((1 - bytes / before.originalBytes) * 1000) / 10 : 0;\n  out.push({\n    json: {\n      ...before,\n      compressedBytes: bytes,\n      compressedMB: Math.round(bytes / 1e4) / 100,\n      savedPct: saved,\n      status: 'compressed',\n    },\n    binary: item.binary,\n  });\n}\nreturn out;"
      },
