    {
      "parameters": {
        "jsCode": "// Measures the original file and picks a compression level from the size bands in Configuration.\n// n8n reports binary size as a string such as \"12.4 MB\"; this converts it to bytes.\nconst cfg = $('Configuration').first().json;\nconst file = $('Watch Inbox Folder').first().json;\n\nfunction toBytes(sizeText) {\n  const m = String(sizeText ?? '').match(/([\\d.]+)\\s*(B|kB|KB|MB|GB)/i);\n  if (!m) return 0;\n  const n = parseFloat(m[1]);\n  const unit = m[2].toLowerCase();\n  return unit === 'gb' ? n * 1e9 : unit === 'mb' ? n * 1e6 : unit === 'kb' ? n * 1e3 : n;\n}\n\nconst out = [];\nfor (const item of $input.all()) {\n  const bytes = toBytes(item.binary?.data?.fileSize);\n  const mb = bytes / 1e6;\n  let level = 'skip';\n  if (mb >= cfg.highAboveMB) level = 'high';\n  else if (mb >= cfg.mediumAboveMB) level = 'medium';\n  else if (mb >= cfg.skipBelowMB) level = 'low';\n  out.push({\n    json: {\n      ...item.json,\n      fileName: file.name ?? item.binary?.data?.fileName ?? 'file.pdf',\n      originalLink: file.webViewLink ?? '',\n      description: String(item.json.text ?? '').trim(),\n      originalBytes: bytes,\n      originalMB: Math.round(mb * 100) / 100,\n      compressionLevel: level,\n      needsCompression: level !== 'skip',\n      config: cfg,\n    },\n    binary: item.binary,\n  });\n}\nreturn out;"
      },
      "id": "6112f563-dcf5-4193-a85a-4e0f681de53f",
