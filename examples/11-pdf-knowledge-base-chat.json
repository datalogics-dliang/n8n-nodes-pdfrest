      "id": "a6fb69ea-d705-42fe-9be1-d9a9a4e13d12",
      "name": "Convert PDF to Markdown",
      "type": "@pdfrest/n8n-nodes-pdfrest.pdfRest",
      "typeVersion": 1,
      "position": [
        2160,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Splits Markdown on pdfRest page-break comments so each chunk carries page number, file name, and Drive link.\nconst file = $('Watch Knowledge Folder').first().json;\nconst info = $('Reattach PDF').first().json;\nconst ocrApplied = $('Needs OCR?').first().json.image_only === true;\nconst out = [];\nfor (const item of $input.all()) {\n  const md = String(item.json.markdown ?? '');\n  const pages = md.split(/<!--\\s*page\\s*break\\s*-->/i);\n  pages.forEach((text, i) => {\n    const clean = text.trim();\n    if (!clean) return;\n    out.push({ json: {\n      text: clean,\n      fileName: file.name ?? 'document.pdf',\n      driveLink: file.webViewLink ?? '',\n      page: i + 1,\n      pageCount: info.page_count ?? pages.length,\n      ocrApplied,\n    } });\n  });\n}\nif (out.length === 0) out.push({ json: { text: '(no text extracted)', fileName: file.name, driveLink: file.webViewLink ?? '', page: 1, pageCount: 0, ocrApplied } });\nreturn out;"
      },
