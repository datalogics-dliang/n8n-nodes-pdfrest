    {
      "parameters": {
        "jsCode": "// One item per attachment. Reads binary from the Gmail trigger and copies it\n// to a plain object so the Code sandbox accepts it. Binary lands on `data`\n// so every downstream node reads the same property.\nconst cfg = $('Set Folder and Index IDs').first().json;\nconst out = [];\n\nfor (const item of $('When Email Received').all()) {\n  const email = item.json;\n  const keys = Object.keys(item.binary || {}).filter(k => k.startsWith('attachment_'));\n\n  for (const key of keys) {\n    const bin = JSON.parse(JSON.stringify(item.binary[key]));\n    out.push({\n      json: {\n        messageId: email.id,\n        subject: email.Subject ?? email.subject ?? '(no subject)',\n        from: email.From ?? email.from ?? '',\n        receivedAt: email.date ?? new Date().toISOString(),\n        fileName: bin.fileName ?? `${key}.pdf`,\n        mimeType: bin.mimeType ?? '',\n        config: cfg,\n      },\n      binary: { data: bin },\n    });\n  }\n}\n\nreturn out;"
      },
